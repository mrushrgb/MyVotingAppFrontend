# React Voting System Environment Variables

# Backend API Base URL
# Development: http://localhost:5000
# Production: https://voting-system-backend.azurewebsites.net
REACT_APP_API_BASE_URL=http://localhost:5000

# Keep source maps for debugging but suppress warnings
GENERATE_SOURCEMAP=true

# Skip preflight check (helpful for some development setups)
SKIP_PREFLIGHT_CHECK=true
